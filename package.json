    "@tsconfig/node20": "^20.1.10",
    "@types/lodash-es": "^4.17.12",
    "@unhead/vue": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "date-fns": "^4.4.0",
    "lodash-es": "^4.18.1",
    "npm-run-all": "^4.1.5",
    "pinia": "^4.0.3",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.11",
    "vuetify": "4.1.11"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
