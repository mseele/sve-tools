{
  "name": "sve-tools",
  "version": "2.10.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check type-check:tsrs lint format \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "type-check:tsrs": "tsrs -p tsconfig.app.json --noEmit --composite false",
    "lint": "oxlint",
    "format": "oxfmt",
    "release": "standard-version"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@tiptap/vue-3": "^3.32.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/lodash-es": "^4.17.12",
    "@unhead/vue": "^3.4.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "date-fns": "^4.4.0",
    "lodash-es": "^4.18.1",
    "npm-run-all": "^4.1.5",
    "pinia": "^4.1.0",
    "typescript": "6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "vuetify": "4.3.1"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/node": "^26.6.6",
    "oxfmt": "0.75.0",
    "oxlint": "^1.90.0",
    "standard-version": "^9.5.0",
    "tsrs": "^0.20.1-ts7.1.0-beta"
  }
}
